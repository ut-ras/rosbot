<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

  <!-- ==================== BASE LINK ==================== -->
  <!-- The base_link is the center of your rover body at ground level -->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- MEASURE: approximate rover body size in meters (length, width, height) -->
        <box size="0.40 0.30 0.10"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ==================== LIDAR LINK ==================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joint connecting base_link to lidar_link -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!--
      MEASURE AND UPDATE THESE VALUES:
      x = how far forward the lidar is from rover center (positive = forward)
      y = how far left/right (positive = left)
      z = height above base_link
    -->
    <origin xyz="0.10 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CAMERA LINK ==================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <!-- RealSense D435 is roughly 9cm wide, 2.5cm tall, 2.5cm deep -->
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joint connecting base_link to camera_link -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!--
      MEASURE AND UPDATE THESE VALUES:
      x = how far forward the camera is from rover center
      y = how far left/right
      z = height above base_link
    -->
    <origin xyz="0.15 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frame — RealSense publishes data in this frame -->
  <!-- Do not change the rpy here, this is a ROS convention for camera frames -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>